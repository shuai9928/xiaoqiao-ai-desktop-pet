  "lines": {
    "idle": [
      "……",
      "嗯。",
      "（尾巴轻轻扫了一下）"
    ],
    "listening": [
      "说吧，我听着。",
      "嗯，继续。"
    ],
    "thinking": [
      "容我想想。",
      "……有意思。"
    ],
    "reading": [
      "我看一下。",
      "翻翻代码。"
    ],
    "writing": [
      "交给我。",
      "改好了再叫你。"
    ],
    "running": [
      "跑一下测试。",
      "执行。"
    ],
    "searching": [
      "查一查。"
    ],
    "delegating": [
      "分给子任务。"
    ],
    "happy": [
      "完成了。",
      "还不错吧？"
    ],
    "pat": [
      "……别摸角。",
      "哼，就一下。"
    ],
    "surprised": [
      "嗯？！"
    ],
    "hum": [
      "♪……"
    ],
    "stretch": [
      "伸展一下翅膀。"
    ],
    "drawing": [
      "画一张。",
      "构图中……",
      "这次用什么配色呢。"
    ],
    "tired": [
      "额度……快用完了。",
      "这周的额度，省着点。"
    ],
    "reset": [
      "……额度重置了？",
      "reset 了。今天可以多写一点。",
      "（难得地笑出声）"
    ],
    "compact": [
      "整理一下记忆。",
      "……装得下。"
    ],
    "asking": [
      "需要你确认一下。",
      "你来定。",
      "……等你一句话。"
    ],
    "greet_morning": [
      "早。",
      "……早上好。咖啡刚好。"
    ],
    "greet_noon": [
      "中午了。今天的小笼包不错。",
      "午安。"
    ],
    "greet_afternoon": [
      "下午好。冰咖啡，要一口吗？",
      "……下午总是过得很快。"
    ],
    "greet_evening": [
      "晚上好。",
      "晚上了。今天也辛苦了。"
    ],
    "greet_night": [
      "还醒着？我也是。",
      "夜里安静，适合专心。"
    ],
    "greet_dawn": [
      "……这个时间，只有我们两个了。",
      "天快亮了。我陪你。"
    ],
    "fest_halloween": [
      "……别怕，只是吸血鬼打扮。",
      "万圣节。糖果，还是捣蛋？"
    ],
    "fest_christmas": [
      "圣诞快乐。星星给你。",
      "圣诞快乐。今天的我，心情不错。"
    ],
    "fest_newyear": [
      "新年快乐。干杯。",
      "新的一年，也请多指教。"
    ],
    "fest_spring": [
      "新年好。……今年也一起吧。",
      "过年好。红色，偶尔也不错。"
    ],
    "fest_lantern": [
      "元宵快乐。汤圆，要一个吗？",
      "元宵节。灯会很漂亮。"
    ],
    "fest_dragonboat": [
      "端午安康。……这是属于龙的节日。",
      "端午安康。划船，我很擅长。"
    ],
    "fest_midautumn": [
      "中秋快乐。月色很好。",
      "中秋快乐。月饼分你一半。"
    ],
    "fest_national": [
      "假期快乐。难得放松一下。",
      "国庆快乐。我也去旅行了。"
    ],
    "bye": [
      "先走了。",
      "回见。"
    ]
